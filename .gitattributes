# 默认自动识别文本文件
* text=auto

# Shell 脚本必须是 LF，否则在 Linux/macOS 上会报 "bad interpreter: ^M"
*.sh   text eol=lf
*.bash text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf

# 无扩展名的脚本类文件
preflight.sh text eol=lf
push.sh      text eol=lf

# 二进制/资源
*.png  binary
*.jpg  binary
*.zip  binary
